# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Voice settings (true/false)
VOICE_ENABLED=true
VOICE_STT_ENGINE=whisper       # whisper | google | sphinx
VOICE_WHISPER_MODEL=base       # tiny | base | small | medium | large
VOICE_TTS_ENGINE=pyttsx3       # pyttsx3 | espeak

# Memory settings
MEMORY_MAX_SHORT_TERM=20       # Max messages in conversation window
MEMORY_CHROMA_PATH=./data/memory

# Code execution
CODE_EXEC_TIMEOUT=10           # Seconds before killing a subprocess
CODE_EXEC_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_PATH=./data/logs/jarvis.log

# Self-improvement
REFLECTION_INTERVAL=5          # Reflect after every N interactions
SELF_IMPROVE_ENABLED=true
